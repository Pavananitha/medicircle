# MediCircle Environment Configuration

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medicircle?schema=public"

# JWT Authentication
JWT_SECRET="medicircle_super_secure_jwt_secret_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=5000

# Backend Base API URL (for mobile client connectivity)
API_BASE_URL="http://localhost:5000"

# Medication Missed Dose Grace Period (in minutes)
MISSED_DOSE_GRACE_PERIOD_MINUTES=30
